# Copy to C:\Users\<you>\.ssh\config (merge with existing Host blocks).
# XO-1 runs OpenSSH 5.5 — modern Windows OpenSSH needs legacy algorithm overrides.

Host xo1 olpc-xo1 10.0.0.25
    HostName 10.0.0.25
    User olpc
    IdentityFile ~/.ssh/id_rsa_olpc

    HostKeyAlgorithms +ssh-rsa,+ssh-dss
    PubkeyAcceptedAlgorithms +ssh-rsa
    KexAlgorithms +diffie-hellman-group-exchange-sha256,+diffie-hellman-group14-sha1,+diffie-hellman-group-exchange-sha1,+diffie-hellman-group1-sha1
    Ciphers +aes128-ctr,+aes256-ctr,+aes128-cbc,+aes256-cbc
    MACs +hmac-sha2-256,hmac-sha1

    # Trusted LAN automation: accept first connect, or use both lines below to disable checks entirely
    StrictHostKeyChecking accept-new
    # StrictHostKeyChecking no
    # UserKnownHostsFile NUL
